{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rubric Slice",
  "type": "object",
  "required": ["rows"],
  "additionalProperties": false,
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "finding_category",
          "part11_clauses",
          "clause_quote",
          "code_patterns",
          "mapping_confidence",
          "gamp5_category",
          "evidence_needed",
          "false_positive_traps"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P11-11\\.(10[acdegh]|30|50|70|100|200|300)-[0-9]{3}$"
          },
          "finding_category": { "type": "string", "minLength": 3 },
          "part11_clauses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "11.10(a)", "11.10(c)", "11.10(d)", "11.10(e)",
                "11.10(g)", "11.10(h)",
                "11.30", "11.50", "11.70",
                "11.100", "11.200", "11.300"
              ]
            }
          },
          "clause_quote": { "type": "string", "minLength": 5 },
          "code_patterns": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 5 }
          },
          "mapping_confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "none"]
          },
          "gamp5_category": { "type": "integer", "enum": [1, 3, 4, 5] },
          "evidence_needed": { "type": "string", "minLength": 5 },
          "false_positive_traps": {
            "type": "array",
            "items": { "type": "string", "minLength": 3 }
          }
        }
      }
    }
  }
}
